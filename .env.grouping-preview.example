# Copy to .env.grouping-preview.local. The *.local file is intentionally ignored.
VITE_GROUPING_PREVIEW=true
VITE_ENABLE_WATCHLIST_GROUPING=true
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-anihub-f01
VITE_FIREBASE_API_KEY=demo-anihub-f01
VITE_FIREBASE_AUTH_DOMAIN=demo-anihub-f01.localhost
VITE_FIREBASE_STORAGE_BUCKET=demo-anihub-f01.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:groupingpreview
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
